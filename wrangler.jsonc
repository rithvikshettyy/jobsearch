/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * NOTE: `nodejs_compat` is intentionally NOT enabled. This Worker must not use
 * Node built-ins — an accidental `node:*` import should fail the build.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "job-bot",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-01",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"triggers": {
		// Cron triggers do not retry. Each tick polls COMPANIES_PER_TICK companies
		// and advances the cursor, so the full board list rotates over several ticks.
		"crons": ["*/15 * * * *"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "job-bot-db",
			// TODO: paste the id printed by `npx wrangler d1 create job-bot-db`
			"database_id": "REPLACE_WITH_DATABASE_ID",
			"migrations_dir": "migrations"
		}
	],
	"vars": {
		"TELEGRAM_CHAT_ID": "REPLACE_WITH_CHAT_ID"
	}
	// Secrets (never in this file):
	//   npx wrangler secret put TELEGRAM_BOT_TOKEN
	//   npx wrangler secret put ADMIN_TOKEN     # optional, gates POST /run
}
