/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * NOTE: `nodejs_compat` is intentionally NOT enabled. This Worker must not use
 * Node built-ins — an accidental `node:*` import should fail the build.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "job-bot",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-01",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"triggers": {
		// Cron triggers do not retry. Each tick polls COMPANIES_PER_TICK companies
		// (least-recently-polled first), so the full board list rotates over several ticks.
		// */2 is a burn-in cadence: 3 boards per tick, 64 boards rotate in ~43 minutes. Move
		// back to */15 once the deploy is proven — ATS boards do not update faster
		// than hourly, so the extra ticks buy freshness that does not exist.
		"crons": ["*/2 * * * *"]
	},
	"d1_databases": [
		{
			// Must stay "DB" — src/ reads env.DB everywhere.
			"binding": "DB",
			"database_name": "job-bot-db",
			"database_id": "d45bc1b8-38ec-440d-82f6-6654b89fe353",
			"migrations_dir": "migrations"
		}
	],
	"vars": {
		// TELEGRAM_CHAT_ID is a secret, not a var, so the id is never committed.
		// It is the "JobSearch" group: one sendMessage reaches every member, so
		// adding people costs no extra subrequests.
		//
		// NOTE: if Telegram ever upgrades this group to a supergroup, the id
		// changes to a -100... form and sends start failing with "chat not found".
		// A JD that names no experience number is NOT sent. "true" sends it only
		// when the title reads entry-level (intern, fresher, junior, SDE 1 ...).
		"SEND_UNKNOWN_YOE": "false"
	}
	// Secrets (never in this file):
	//   npx wrangler secret put TELEGRAM_BOT_TOKEN
	//   npx wrangler secret put TELEGRAM_CHAT_ID           # the group or chat id, e.g. -100123...
	//   npx wrangler secret put TELEGRAM_OWNER_USER_ID     # your user id, restricts button taps in a group
	//   npx wrangler secret put INGEST_KEY                 # guards /ingest, /queue, /jobs/:id/status, /x/*
	//   npx wrangler secret put TG_WEBHOOK_SECRET          # Telegram echoes it on every webhook call
	//   npx wrangler secret put ADMIN_TOKEN     # optional, gates POST /run
	//   npx wrangler secret put ADZUNA_APP_ID   # optional, for the adzuna source
	//   npx wrangler secret put ADZUNA_APP_KEY
	//   npx wrangler secret put RAPIDAPI_KEY    # optional, for the jsearch source
}
