# Copy to .env (git-ignored). Never commit it, never paste its values into a chat or a log.

# The deployed job-bot Worker, no trailing slash.
JOB_BOT_URL=https://job-bot.YOUR-SUBDOMAIN.workers.dev

# Same value as `wrangler secret put INGEST_KEY`.
INGEST_KEY=

# A BURNER X account. Never your real one: scraping with a logged-in account can get it locked or banned.
# Log in to the burner in a browser, open DevTools > Application > Cookies > https://x.com, and copy
# the two values. The whole cookie string goes on one line, no quotes.
X_BURNER_USERNAME=
X_BURNER_COOKIES=auth_token=PASTE_AUTH_TOKEN; ct0=PASTE_CT0

# Optional second burner, used if the first fails. Same shape, numbered.
# X_BURNER_2_USERNAME=
# X_BURNER_2_COOKIES=auth_token=...; ct0=...
