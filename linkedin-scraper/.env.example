# Copy to .env (git-ignored). Never commit it, never paste its values into a chat or a log.

# The deployed job-bot Worker, no trailing slash.
JOB_BOT_URL=https://job-bot.YOUR-SUBDOMAIN.workers.dev

# Same value as `wrangler secret put INGEST_KEY`.
INGEST_KEY=

# Read README.md first. The LinkedIn library needs a signed-in LinkedIn session, scraping breaks LinkedIn's
# terms, and LinkedIn restricts accounts that do it. Do not use the account you rely on for your job search.
# Live runs refuse to start unless this says yes. Offline runs (--fixture) do not need it.
LINKEDIN_ACCEPT_RISK=no

# There is deliberately no LinkedIn password or cookie setting here. Sign in once with `lijs login` in your own
# terminal; the session lives in ~/.lijs/chrome-profile, outside this repo.
